{
  "app-id": "net.mediaarea.MediaInfo",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "default-branch": "stable",
  "sdk": "org.freedesktop.Sdk",
  "command": "mediainfo-gui",
  "rename-desktop-file": "mediainfo-gui.desktop",
  "rename-appdata-file": "mediainfo-gui.metainfo.xml",
  "rename-icon": "mediainfo",
  "finish-args": [
    "--filesystem=host:ro",
    "--filesystem=home:rw",
    "--socket=wayland",
    "--socket=x11",
    "--share=network",
    "--share=ipc"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "wxwidgets",
      "cleanup": [
        "/bin",
        "/share",
        "/lib/wx"
      ],
      "rm-configure": true,
      "config-opts": [
        "--enable-shared",
        "--with-gtk=3",
        "--enable-html",
        "--enable-webview",
        "--enable-webviewwebkit"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/wxWidgets/wxWidgets/releases/download/v3.3.1/wxWidgets-3.3.1.tar.bz2",
          "sha256": "f936c8d694f9c49a367a376f99c751467150a4ed7cbf8f4723ef19b2d2d9998d"
        },
        {
          "type": "script",
          "commands": [
            "cp -p /usr/share/automake-*/config.{sub,guess} .",
            "autoconf -f -B build/autoconf_prepend-include"
          ]
        }
      ]
    },
    {
      "name": "libzen",
      "subdir": "Project/GNU/Library",
      "config-opts": [
        "--enable-shared",
        "--disable-static"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/libzen/0.4.41/libzen_0.4.41.tar.xz",
          "sha256": "933bad3b7ecd29dc6bdc88a83645c83dfd098c15b0b90d6177a37fa1536704e8"
        }
      ]
    },
    {
      "name": "libmediainfo",
      "subdir": "Project/GNU/Library",
      "config-opts": [
        "--enable-shared",
        "--disable-static",
        "--with-libcurl"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/libmediainfo/26.05/libmediainfo_26.05.tar.xz",
          "sha256": "c08b2d87b2fb5edb4526c2a8a317eb1f2cff44807e4631a037ca9f9a1d455054"
        }
      ]
    },
    {
      "name": "mediainfo",
      "subdir": "Project/GNU/CLI",
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/mediainfo/26.05/mediainfo_26.05.tar.xz",
          "sha256": "f852093f9050022d699606eeabb38b24da5523d0212fab64dc4e4d3e46b56de1"
        }
      ]
    },
    {
      "name": "mediainfo-gui",
      "subdir": "Project/GNU/GUI",
      "cleanup": [
        "/share/pixmaps",
        "/share/apps",
        "/share/kde4",
        "/share/kservices5"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/mediainfo/26.05/mediainfo_26.05.tar.xz",
          "sha256": "f852093f9050022d699606eeabb38b24da5523d0212fab64dc4e4d3e46b56de1"
        }
      ]
    }
  ]
}
