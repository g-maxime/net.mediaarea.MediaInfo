{
  "app-id": "net.mediaarea.MediaInfo",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "base": "io.qt.qtwebengine.BaseApp",
  "base-version": "6.10",
  "default-branch": "stable",
  "sdk": "org.kde.Sdk",
  "command": "mediainfo-gui",
  "rename-desktop-file": "mediainfo-gui.desktop",
  "rename-appdata-file": "mediainfo-gui.metainfo.xml",
  "rename-icon": "mediainfo",
  "finish-args": [
    "--filesystem=host:ro",
    "--filesystem=home:rw",
    "--socket=wayland",
    "--socket=x11",
    "--share=network",
    "--share=ipc",
    "--env=GV_PLUGIN_PATH=/app/lib/graphviz",
    "--env=GVBINDIR=/app/bin",
    "--env=QTWEBENGINEPROCESS_PATH=/app/bin/QtWebEngineProcess",
    "--env=QTWEBENGINE_DISABLE_SANDBOX=1"
  ],
  "cleanup-commands": [ "/app/cleanup-BaseApp.sh" ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "*.la",
    "*.a"
  ],
  "build-options": {
    "env": {
      "GV_PLUGIN_PATH": "/app/lib/graphviz",
      "GVBINDIR": "/app/bin",
      "QMAKEPATH": "/app",
      "QMAKEFEATURES": "/app/mkspecs/features",
      "PKG_CONFIG_PATH": "/app/lib/pkgconfig:/usr/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig",
      "CPLUS_INCLUDE_PATH": "/app/include",
      "LIBRARY_PATH": "/app/lib",
      "LD_LIBRARY_PATH": "/app/lib",
      "QTWEBENGINE_DISABLE_SANDBOX": "1"
    }
  },
  "modules": [
    {
      "name": "graphviz",
      "cleanup": [
        "/share/man",
        "/share/graphviz/doc",
        "/lib/cmake"
      ],
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-static",
        "--enable-shared",
        "--with-cairo",
        "--disable-swig",
        "--disable-python",
        "--disable-perl",
        "--disable-ruby",
        "--disable-tcl",
        "--without-x",
        "--without-gdk-pixbuf"
      ],
      "post-install": [ "dot -c" ],
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.com/graphviz/graphviz/-/archive/12.2.1/graphviz-12.2.1.tar.gz",
          "sha256": "91d444b4dabdaf5bfa7c6fcc3a1ee5d41e588af6079ebc030f0acb79e48a56ea"
        }
      ]
    },
    {
      "name": "libmms",
      "config-opts": [
        "--disable-static",
        "--enable-shared"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/libmms/libmms/0.6.4/libmms-0.6.4.tar.gz",
          "sha256": "3c05e05aebcbfcc044d9e8c2d4646cd8359be39a3f0ba8ce4e72a9094bee704f"
        }
      ]
    },
    {
      "name": "libzen",
      "subdir": "Project/GNU/Library",
      "config-opts": [
        "--enable-shared",
        "--disable-static"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/libzen/0.4.41/libzen_0.4.41.tar.xz",
          "sha256": "933bad3b7ecd29dc6bdc88a83645c83dfd098c15b0b90d6177a37fa1536704e8"
        }
      ]
    },
    {
      "name": "libmediainfo",
      "subdir": "Project/GNU/Library",
      "config-opts": [
        "--enable-shared",
        "--disable-static",
        "--with-libcurl",
        "--with-graphviz=runtime",
        "--with-libmms"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/libmediainfo/26.05/libmediainfo_26.05.tar.xz",
          "sha256": "c08b2d87b2fb5edb4526c2a8a317eb1f2cff44807e4631a037ca9f9a1d455054"
        }
      ]
    },
    {
      "name": "mediainfo",
      "subdir": "Project/GNU/CLI",
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/mediainfo/26.05/mediainfo_26.05.tar.xz",
          "sha256": "f852093f9050022d699606eeabb38b24da5523d0212fab64dc4e4d3e46b56de1"
        }
      ]
    },
    {
      "name": "mediainfo-gui",
      "subdir": "Project/QMake/GUI",
      "buildsystem": "qmake",
      "config-opts": [ "MediaInfoQt.pro", "-after", "target.path=/app/bin" ],
      "post-install": [
        "install -D -m 0644 ../../GNU/GUI/mediainfo-gui.desktop /app/share/applications/mediainfo-gui.desktop",
        "install -D -m 0644 ../../GNU/GUI/mediainfo-gui.metainfo.xml /app/share/metainfo/mediainfo-gui.metainfo.xml",
        "install -D -m 0644 ../../../Source/Resource/Image/MediaInfo.png /app/share/icons/hicolor/256x256/apps/mediainfo.png",
        "install -D -m 0644 ../../../Source/Resource/Image/MediaInfo.svg /app/share/icons/hicolor/scalable/apps/mediainfo.svg"
      ],
      "cleanup": [
        "/share/pixmaps",
        "/share/apps",
        "/share/kde4",
        "/share/kservices5"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://mediaarea.net/download/source/mediainfo/26.05/mediainfo_26.05.tar.xz",
          "sha256": "f852093f9050022d699606eeabb38b24da5523d0212fab64dc4e4d3e46b56de1"
        }
      ]
    }
  ]
}
